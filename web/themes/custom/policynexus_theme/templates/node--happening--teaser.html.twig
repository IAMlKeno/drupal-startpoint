{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

<div class="happening">
  <div class="container">
    <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#c8a24a;margin-bottom:12px">{{ content.field_tag_line }}</div>
    {% block title %}
      {% if label %}
        <h3 {{ title_attributes.addClass('node__title', 'teaser__title') }} style="font-family:'Libre Baskerville',serif;font-size:19.5px;color:#10243c;margin:0 0 10px;line-height:1.34">
          <a href="{{ url }}" rel="bookmark">{{ label }}</a>
        </h3>
      {% endif %}
    {% endblock %}
    {% block image %}{{~ content.field_image ~}}{% endblock %}
    {% block content %}
      {{ content|without('field_image', 'links', 'field_tag_line') }}
    {% endblock %}
  </div>
</div>