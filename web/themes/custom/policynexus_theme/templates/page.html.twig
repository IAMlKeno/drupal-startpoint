{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead
 * they should be in the html.html.twig template in this directory.
 *
 * @ingroup themeable
 */
#}

{% include '@policynexus_theme/header.html.twig' %}

{% if page.hero %}
  <div class="hero">
    {{ page.hero }}
  </div>
{% endif %}

<main class="main-content" role="main">
  {% if hero_node %}
    <header class="page__hero">
      <div class="container">
        <div class="page__hero-content">
          {% if hero_eyebrow %}
            <div class="page__eyebrow">{{ hero_eyebrow }}</div>
          {% endif %}
          <h1 class="page__hero-title">{{ hero_title }}</h1>
          {% if hero_summary %}
            <div class="page__hero-description">{{ hero_summary }}</div>
          {% endif %}
          {% if hero_ctas %}
            <div class="page__hero-actions">
              {% for item in hero_ctas %}
                <a href="{{ item.url }}" class="button {{ loop.first ? 'button--primary' : 'button--secondary' }}">{{ item.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% if hero_image %}
          <div class="page__hero-image">
            {{ hero_image }}
          </div>
        {% endif %}
      </div>
    </header>
  {% endif %}

  {% if page.content or page.sidebar %}
    {% if page.sidebar %}
      {# Sidebar region sits to the left of the main content column. #}
      <div class="container page-layout page-layout--with-sidebar">
        <aside class="page-layout__sidebar" role="complementary">
          {{ page.sidebar }}
        </aside>
        <div class="page-layout__main">
          {{ page.content }}
        </div>
      </div>
    {% elseif hero_node %}
      {# Node templates provide their own containers. #}
      {{ page.content }}
    {% else %}
      <div class="container">
        {{ page.content }}
      </div>
    {% endif %}
  {% endif %}
</main>

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__bottom">
        <div>
          <h3>Project PolicyLink</h3>
          <p>
            A demonstration consultation site. Content shown is placeholder material for review purposes.
          </p>
        </div>
        <div class="footer__social">
          <!-- Social links can be added here -->
        </div>
        {% if page.footer %}
          <div class="footer__menu">
            {{ page.footer }}
          </div>
        {% endif %}
        <div class="contact">
          <h6>Contact</h6>
          <p>hello@policylinkdemo</p>
          <p>90212345678</p>
          <p>123 Your Civic Address</p>
        </div>
      </div>
      <div class="footer__copyright footer__bottom">
        <div>&copy; 2026 PolicyLink Nexus</div>
        <div>All rights reserved.</div>
      </div>
    </div>
  </div>
</footer>
