{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead
 * they should be in the html.html.twig template in this directory.
 *
 * @ingroup themeable
 */
#}

{% include '@policynexus_theme/header.html.twig' %}

{# Check if this is a page node with hero by looking for page__hero class in content #}
{% set has_page_hero = page.content|render|striptags|trim and 'page__hero' in page.content|render %}

{% if page.hero %}
  <div class="hero">
    {{ page.hero }}
  </div>
{% endif %}

<main class="main-content" role="main">
  {% if page.content %}
    {% if has_page_hero %}
      {# For page nodes with hero, render content without container wrapper #}
      {{ page.content }}
    {% else %}
      {# For other content types, use container wrapper #}
      <div class="container">
        {{ page.content }}
      </div>
    {% endif %}
  {% endif %}
</main>

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__bottom">
        <div>
          <h3>Project PolicyLink</h3>
          <p>
            A demonstration consultation site. Content shown is placeholder material for review purposes.
          </p>
        </div>
        <div class="footer__social">
          <!-- Social links can be added here -->
        </div>
        {% if page.footer %}
          <div class="footer__menu">
            {{ page.footer }}
          </div>
        {% endif %}
        <div class="contact">
          <h6>Contact</h6>
          <p>hello@policylinkdemo</p>
          <p>90212345678</p>
          <p>123 Your Civic Address</p>
        </div>
      </div>
      <div class="footer__copyright footer__bottom">
        <div>&copy; 2026 PolicyLink Nexus</div>
        <div>All rights reserved.</div>
      </div>
    </div>
  </div>
</footer>
