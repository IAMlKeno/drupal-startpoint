{#
/**
 * @file
 * Theme override to display a Basic Page node.
 *
 * Available variables:
 * - node: The node entity
 * - content: The node content array
 * - attributes: HTML attributes for the article
 *
 * @ingroup themeable
 */
#}

{% if page %}
  <!-- Full page view: the hero is rendered by page.html.twig -->
  <!-- Additional content -->
  <article{{ attributes.addClass('node', 'node--page', 'page') }}>
    <div class="container">
      <div class="page__content">
        {{ content|without('title', 'field_summary', 'field_header_text', 'field_eyebrow', 'field_featured_image', 'field_cta') }}
      </div>
    </div>
  </article>
{% else %}
<article{{ attributes.addClass('node', 'node--page', 'page') }}>
    <!-- Teaser/Card view -->
    <header class="page__header">
      <h2{{ title_attributes.addClass('page__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    </header>
    <div class="page__teaser">
      {{ content.body }}
    </div>
  </article>
{% endif %}
