{#
/**
 * @file
 * Theme override to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 * - content: The node content array.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: Same as attributes, except applied to the title tag.
 * - content_attributes: Same as attributes, except applied to the content tag.
 * - author_attributes: Same as attributes, except applied to the author tag.
 * - display_submitted: Whether submission information should be displayed.
 * - metadata: Metadata for this node.
 * - url: Direct URL of the current node.
 * - comment_count: Number of comments attached to the node.
 * - logged_in: Flag for authenticated user status.
 * - is_admin: Flag for admin user status.
 *
 * @ingroup themeable
 */
#}

<article{{ attributes.addClass('node', 'node--' ~ node.bundle) }}>
  {% if not page %}
    <header class="node__header">
      {{ title_prefix }}
      <h2{{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
      {{ title_suffix }}

      {% if display_submitted %}
        <div class="node__meta">
          {{ author_picture }}
          <span class="node__submitted">
            {{ submitted }}
          </span>
        </div>
      {% endif %}
    </header>
  {% endif %}

  <div{{ content_attributes.addClass('node__content') }}>
    {{ content }}
  </div>
</article>
