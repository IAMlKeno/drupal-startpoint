{#
/**
 * @file
 * Theme override to display a Research Post node.
 *
 * Available variables:
 * - node: The node entity
 * - content: The node content array
 * - attributes: HTML attributes for the article
 *
 * @ingroup themeable
 */
#}

<article{{ attributes.addClass('node', 'node--research-post', 'research-post') }}>
  {% if not page %}
    <header class="research-post__header">
      <h2{{ title_attributes.addClass('research-post__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    </header>
  {% endif %}

  <div class="container">
    {% if content.field_featured_image %}
      <div class="research-post__featured">
        {{ content.field_featured_image }}
      </div>
    {% endif %}
    <div class="research-post__content">
      <!-- Main content column -->
      <div class="research-post__summary">
        {{ content.field_summary }}
      </div>
      <!-- Main content column -->
      <div class="research-post__body">
        {{ content.body }}
      </div>

      <!-- Sidebar -->
      {# <aside class="research-post__sidebar"> #}
        <!-- Research Area Tags -->
        {# <div class="research-post__categories">
          <h3>Research Areas</h3>
          {{ content.field_research_area }}
        </div>

        <!-- Call-to-Action -->
        <div class="research-post__cta card card--featured">
          <h3 class="card__title">Share This Research</h3>
          <p>Help spread evidence-based policy insights in your community.</p>
          <a href="/get-involved" class="button button--primary">Get Involved</a>
        </div> #}
      {# </aside> #}
    </div>

    {# <!-- Related Posts -->
    {% if content.field_related_posts %}
      <section class="research-post__related">
        <h2>Related Research</h2>
        <div class="grid grid--3col">
          {{ content.field_related_posts }}
        </div>
      </section>
    {% endif %} #}

  <!-- Community comments and form (field_policy_comment) -->
  {# {% if logged_in is false %}
    <h1>log in</h1>
  {% endif %} #}
  <section class="research-post__comments comments">
    <h2 class="comments__title">Community Feedback</h2>
    {% if content.field_policy_comment.0.comments is not empty %}
      {{ content.field_policy_comment }}
    {% else %}
      <div>No comments yets</div>
    {% endif %}
  </section>
  {# {% else %}
    <section>
      <h4>Log in to leave a comment</h4>
    </section> #}

    <!-- Auto-render all remaining fields -->
    {{ content|without('title', 'body', 'featured_image', 'field_summary', 'field_author', 'field_publication_date', 'field_research_area', 'field_related_posts', 'field_policy_comment', 'field_featured_image') }}

  </div>
</article>
