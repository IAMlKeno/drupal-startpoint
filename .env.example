# Database Configuration
MYSQL_DATABASE=swc_squatober
MYSQL_USER=admin
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Google OAuth
DRUPAL_SOCIAL_GOOGLE_CLIENT_ID=your_google_client_id
DRUPAL_SOCIAL_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth (Sign in with Apple)
DRUPAL_SOCIAL_APPLE_TEAM_ID=your_apple_team_id
DRUPAL_SOCIAL_APPLE_KEY_ID=your_apple_key_id
DRUPAL_SOCIAL_APPLE_CLIENT_SECRET=your_apple_client_secret

# Facebook OAuth
DRUPAL_SOCIAL_FACEBOOK_APP_ID=your_facebook_app_id
DRUPAL_SOCIAL_FACEBOOK_APP_SECRET=your_facebook_app_secret

# Site Configuration
DRUPAL_SITE_NAME="Squat With Confidence"
DRUPAL_SITE_MAIL=info@squatwithconfidence.ca

# Trusted Host Patterns (for production)
DRUPAL_TRUSTED_HOST_PATTERNS='^swc\.squatwithconfidence\.ca$'
