<?php

/**
 * @file
 * Functions to support theming in the Squat with Confidence theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function swctheme_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'swc';
  // Theme colour for the mobile browser chrome, matched to the app bar.
  $variables['page']['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => ['name' => 'theme-color', 'content' => '#0E2439'],
    ],
    'swc_theme_color',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function swctheme_preprocess_page(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['is_wod'] = str_contains((string) $route, 'wod')
    || (isset($variables['node']) && $variables['node']?->bundle() === 'wod');

  if ($variables['is_wod']) {
    $variables['#attached']['library'][] = 'swc/wod';
  }
  if (isset($variables['node']) && $variables['node']?->bundle() === 'athlete_profile') {
    $variables['#attached']['library'][] = 'swc/profile';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 */
function swctheme_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  // Views that opt into the JS enhancement layer (instant filters, load-more).
  $enhanced = ['wod_sets', 'athlete_sessions', 'program_calendar'];
  $variables['swc_enhance'] = in_array($view->id(), $enhanced, TRUE);
  $variables['swc_view_style'] = match ($view->id()) {
    'wod_sets' => 'table',
    'athlete_sessions' => 'list',
    default => 'cards',
  };
}

/**
 * Implements hook_form_alter().
 */
function swctheme_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (str_starts_with($form_id, 'wod_log')) {
    $form['#attributes']['data-swc-autosave'] = 'true';
  }
}
