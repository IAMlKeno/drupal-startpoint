{#
/**
 * @file
 * Squat with Confidence override of views-view.html.twig.
 *
 * Adds:
 * - a card/list/table style hook (swc_view_style)
 * - data-swc-view, picked up by js/components/view-enhance.js for instant
 *   exposed-filter submission and a "load more" pager (no page reload)
 *
 * @see swc_preprocess_views_view()
 #}
{%
  set classes = [
    'view',
    'view--' ~ swc_view_style,
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}
  {% if swc_enhance %}data-swc-view="{{ id }}" data-swc-view-dom-id="{{ dom_id }}"{% endif %}>

  {# {{ title_prefix }}
  {% if title %}
    <h2 class="view__title">{{ title }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view__header">{{ header }}</div>
  {% endif %} #}

  {# {% if exposed %}
    <div class="view__filters" data-swc-view-filters>
      {{ exposed }}
    </div>
  {% endif %}

  {% if attachment_before %}
    <div class="view__attachment view__attachment--before">{{ attachment_before }}</div>
  {% endif %} #}

  {% if rows %}
    <small><strong>Current Challenge</strong></small>

    <div class="view__content" data-swc-view-rows aria-busy="false">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view__empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    <div class="view__pager" data-swc-view-pager>
      {{ pager }}
    </div>
  {% endif %}

  {% if attachment_after %}
    <div class="view__attachment view__attachment--after">{{ attachment_after }}</div>
  {% endif %}

  {% if more %}
    <div class="view__more">{{ more }}</div>
  {% endif %}

  {% if footer %}
    <div class="view__footer">{{ footer }}</div>
  {% endif %}

  {% if feed_icons %}
    <div class="view__feed-icons">{{ feed_icons }}</div>
  {% endif %}
</div>
