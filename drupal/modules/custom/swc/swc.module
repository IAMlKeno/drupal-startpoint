<?php

/**
 * @file
 * Squat With Confidence core module.
 *
 * Implements business logic for the SWC coaching platform.
 */

/**
 * Implements hook_form_alter().
 */
function swc_form_alter(&$form, &$form_state, $form_id) {
  // Register form modifications
  if ($form_id === 'user_register_form') {
    // Add custom validation for registration
    $form['#validate'][] = 'swc_user_register_validate';
  }
}

/**
 * Custom validation for user registration.
 */
function swc_user_register_validate(&$form, &$form_state) {
  // Validation logic can be added here
}

/**
 * Implements hook_entity_presave().
 */
function swc_entity_presave($entity) {
  // Validate challenge enrollment before saving
  if ($entity->getEntityTypeId() === 'challenge_enrollment') {
    $enrollment_validator = \Drupal::service('swc.enrollment_validator');
    $validation = $enrollment_validator->validateEnrollment(
      $entity->getAthlete(),
      $entity->getChallenge()
    );

    if (!$validation['allowed']) {
      throw new \Exception($validation['reason']);
    }
  }
}

/**
 * Implements hook_entity_insert().
 */
function swc_entity_insert($entity) {
  // Log enrollment events for funnel tracking
  if ($entity->getEntityTypeId() === 'challenge_enrollment') {
    \Drupal::logger('swc')->info(
      'Athlete @athlete enrolled in challenge @challenge',
      [
        '@athlete' => $entity->getAthlete()->getDisplayName(),
        '@challenge' => $entity->getChallenge()->label(),
      ]
    );
  }
  
  // Log workout sessions for funnel tracking
  if ($entity->getEntityTypeId() === 'workout_session') {
    \Drupal::logger('swc')->info(
      'Athlete @athlete logged workout session',
      ['@athlete' => $entity->getAthlete()->getDisplayName()]
    );
  }
}

/**
 * Implements hook_entity_insert() for check-ins.
 */
function swc_check_in_insert($entity) {
  \Drupal::logger('swc')->info(
    'Athlete @athlete submitted check-in',
    ['@athlete' => $entity->getAthlete()->getDisplayName()]
  );
}

/**
 * Implements hook_entity_insert() for video submissions.
 */
function swc_video_submission_insert($entity) {
  \Drupal::logger('swc')->info(
    'Athlete @athlete submitted video for review',
    ['@athlete' => $entity->getAthlete()->getDisplayName()]
  );
}

/**
 * Implements hook_entity_insert() for coaching relationships.
 */
function swc_coaching_relationship_insert($entity) {
  \Drupal::logger('swc')->info(
    'Coaching relationship created: @athlete with coach @coach (status: @status)',
    [
      '@athlete' => $entity->getAthlete()->getDisplayName(),
      '@coach' => $entity->getCoach()->getDisplayName(),
      '@status' => $entity->get('status')->value,
    ]
  );
}

/**
 * Implements hook_entity_update() for coaching relationships.
 */
function swc_coaching_relationship_update($entity) {
  $original_status = $entity->original->get('status')->value ?? '';
  $new_status = $entity->get('status')->value;

  if ($original_status !== $new_status && $new_status === 'active') {
    \Drupal::logger('swc')->info(
      'Coaching relationship activated for @athlete',
      ['@athlete' => $entity->getAthlete()->getDisplayName()]
    );
  }
}

/**
 * Implements hook_theme().
 */
function swc_theme() {
  return [
    'athlete_dashboard' => [
      'variables' => [
        'user' => NULL,
        'welcome_message' => '',
        'challenge' => NULL,
        'challenge_progress' => NULL,
        'today_workout' => NULL,
        'metrics' => [],
        'recent_check_ins' => [],
        'pending_feedback' => [],
        'has_coach' => FALSE,
        'coach' => NULL,
        'coaching_cta' => '',
      ],
      'template' => 'athlete-dashboard',
    ],
    'coach_dashboard' => [
      'variables' => [
        'coach' => NULL,
        'welcome_message' => '',
        'needs_attention' => [],
        'pending_videos' => [],
        'pending_check_ins' => [],
        'active_athletes' => [],
        'active_relationships' => [],
      ],
      'template' => 'coach-dashboard',
    ],
  ];
}
